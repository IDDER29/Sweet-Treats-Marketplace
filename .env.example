# External backend REST API base URL (required)
NEXT_PUBLIC_API_URL=https://your-api.example.com

# Canonical site URL — used by sitemap.xml and OG tags (required in production)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-strong-random-secret-here
AUTH_SECRET=your-strong-random-secret-here

# NextAuth canonical URL (required in production to prevent open-redirect)
NEXTAUTH_URL=https://yourdomain.com

# Google OAuth (obtain from console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# UploadThing (obtain from uploadthing.com dashboard)
UPLOADTHING_TOKEN=your-uploadthing-token
